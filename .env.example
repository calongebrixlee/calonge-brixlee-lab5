# Copy this file to .env for local use. Never commit the filled-in file.
APP_ENV=development
APP_KEY=generate-a-long-random-value

# Aiven MySQL connection
DB_HOST=your-aiven-host
DB_PORT=your-aiven-port
DB_USERNAME=your-aiven-username
DB_PASSWORD=your-aiven-password
DB_DATABASE=mydb
DB_SSL_CA=certs/ca.pem
DB_SSL_VERIFY=1

# Product application login
AUTH_USERNAME=choose-a-login-name
AUTH_PASSWORD_HASH=generate-with-password-hash
